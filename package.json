{
  "name": "fliq-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test",
    "test:a11y": "node tests/a11y-regression.test.mjs",
    "test:logo": "node tests/logo-navigation.test.mjs",
    "test:ai": "node tests/ai-resilience.test.mjs",
    "test:live": "node tests/live-inspection.test.mjs",
    "test:consistency": "node tests/report-consistency.test.mjs",
    "test:pricing": "node tests/pricing.test.mjs",
    "test:pricing-auth": "node tests/pricing-auth.test.mjs",
    "test:polar": "node --test tests/polar-webhooks.test.mjs",
    "test:entitlements": "node --test tests/entitlements.test.mjs",
    "test:usage": "node --test tests/realtime-usage.test.mjs",
    "test:lifecycle": "node --test tests/scan-lifecycle.test.mjs",
    "test:screenshots": "node --test tests/screenshots.test.mjs",
    "test:e2e": "node --test tests/e2e.test.js",
    "test:scan-ui": "node tests/run-ui-scan.mjs",
    "test:portability": "node --test tests/hosting-portability.test.mjs",
    "test:netlify": "node tests/netlify-api-verification.test.mjs",
    "deploy:pages": "wrangler pages deploy . --project-name fliq"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "firebase-admin": "^14.5.0",
    "playwright": "^1.55.0"
  }
}
