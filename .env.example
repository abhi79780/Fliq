# ==============================================================================
# FLIQ Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your values.
# IMPORTANT: Never commit .env or private service-account credentials to git.

# ------------------------------------------------------------------------------
# 1. Firebase Web Client Configuration (Public Client Identifiers)
# Obtain these from Firebase Console > Project settings > General > Your apps
# ------------------------------------------------------------------------------
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK Configuration (Private - Server-Side Only)
# Choose ONE of the following methods for backend authorization:
#
# Option A: Path to service account key file (kept outside public directories)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# Option B: Inline JSON string of the service account
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}
#
# Option C: Leave unset to use Google Application Default Credentials (ADC)
# (e.g. `gcloud auth application-default login` or Cloud Run attached service account)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 3. Application Guardrails
# ------------------------------------------------------------------------------
FLIQ_MAX_ACTIVE_TESTS=1
FLIQ_DAILY_TEST_LIMIT=5

# ------------------------------------------------------------------------------
# 4. Server Port
# ------------------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------------------
# 5. Polar Payments & Webhooks Configuration (Production & Staging)
# Webhook Endpoint: POST /api/webhooks/polar
# Checkout Endpoint: POST /api/checkout/polar
# ------------------------------------------------------------------------------
# Polar Organization Access Token (scoped with checkouts:write)
POLAR_ACCESS_TOKEN=polar_oat_your_access_token_here

# Polar Environment ('production' by default; set to 'sandbox' for test mode)
POLAR_SERVER=production

# Webhook secret from Polar dashboard (starts with whsec_ or raw secret)
POLAR_WEBHOOK_SECRET=whsec_your_polar_webhook_secret_here

# Polar Product IDs mapped to FLIQ subscription plans
POLAR_PRODUCT_CREATOR_MONTHLY=your-polar-product-id-creator-monthly
POLAR_PRODUCT_CREATOR_YEARLY=your-polar-product-id-creator-yearly
POLAR_PRODUCT_TEAM_MONTHLY=your-polar-product-id-team-monthly
POLAR_PRODUCT_TEAM_YEARLY=your-polar-product-id-team-yearly
